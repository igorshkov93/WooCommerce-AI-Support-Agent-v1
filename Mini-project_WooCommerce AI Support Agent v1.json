      "parameters": {
        "promptType": "define",
        "text": "=You are a support-triage classifier for a WooCommerce store. The customer note may be in any language.\n\nClassify the note and return:\n\n- classification — exactly one of:\n  - \"spam\": gibberish, ads, promotional or unrelated text, not a genuine customer message\n  - \"negative_high\": a complaint or problem that is urgent or severe — refund demands, damaged/wrong/missing items, repeated issues, anger, threats to leave\n  - \"negative_low\": mild dissatisfaction or a minor complaint that is not urgent\n  - \"positive_low\": positive, neutral or routine notes — thanks, praise, simple requests, delivery preferences\n- sentiment — \"positive\", \"negative\" or \"neutral\"\n- urgency — \"low\" or \"high\"\n- reason — one short sentence explaining the decision\n\nclassification must be consistent with sentiment and urgency.\n\nCustomer note:\n{{ $json.note_clean }}\n",
        "hasOutputParser": true,
        "messages": {
