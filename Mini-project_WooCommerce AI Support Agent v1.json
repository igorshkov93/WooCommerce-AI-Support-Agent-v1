    {
      "parameters": {
        "jsCode": "function cleanNote(text) {\n  if (text == null) return \"\";\n  let s = String(text);\n  s = s.replace(/<[^>]*>/g, \" \");                 // вырезаем HTML-теги\n  s = s.replace(/[\\u0000-\\u001F\\u007F]/g, \" \");   // управляющие символы\n  s = s.replace(/\\s+/g, \" \").trim();              // схлопываем пробелы\n  if (s.length > 1000) s = s.slice(0, 1000).trimEnd() + \"…\"; // лимит длины\n  return s;\n}\n\nreturn $input.all().map(item => {\n  const body = item.json.body ?? item.json;       // объект заказа\n  const billing = body.billing ?? {};\n\n  const noteRaw = body.customer_note ?? \"\";\n  const noteClean = cleanNote(noteRaw);\n\n  const lineItems = Array.isArray(body.line_items) ? body.line_items : [];\n  const products = lineItems.map(li => li.name).filter(Boolean).join(\", \");\n\n  return {\n    json: {\n      order_id: body.id ?? null,\n      status: body.status ?? null,\n      currency: body.currency ?? null,\n      total: body.total ?? null,\n      customer_name: [billing.first_name, billing.last_name].filter(Boolean).join(\" \").trim() || null,\n      email: billing.email ?? null,\n      products: products || null,\n      note_raw: noteRaw,\n      note_clean: noteClean,\n      has_note: noteClean.length > 0,\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        16
      ],
      "id": "e191333c-ac9a-48d1-8bb2-117a07377379",
